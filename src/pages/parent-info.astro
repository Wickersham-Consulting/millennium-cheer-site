---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const paymentLinks = (await getCollection("paymentLinks", ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);

const highlighted = (
  await getCollection("announcements", ({ data }) => data.published && data.highlight)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// 2026–27 full-season donation schedule, split by JV/Varsity Summer Start,
// JV/Varsity Fall Start, and Freshman Athlete tracks.
// Source of truth is the PDF in public/downloads/; this table mirrors it for
// at-a-glance viewing. Update both when the schedule changes each season.
const asOf = "July 10, 2026";
const pdfHref = "/downloads/donation-schedule-2026-27.pdf";

const schedule: {
  item: string;
  accounting: string;
  summer: string;
  fall: string;
  freshman: string;
  fundraising?: boolean;
  subtotal?: boolean;
}[] = [
  { item: "Shoes: Game Day", accounting: "Due 8/24 · link from Rebel", summer: "$105", fall: "$105", freshman: "$105" },
  { item: "Season Apparel: Amazon", accounting: "Due 8/24 · link from Amazon", summer: "$100", fall: "$100", freshman: "$100" },
  { item: "Season Apparel: AZ Embroidery & Printing Lab", accounting: "Due 8/24 · paid through booster club", summer: "$57", fall: "$57", freshman: "$57" },
  { item: "New Backpack — all athletes", accounting: "Due 8/24 · link from Rebel", summer: "$105", fall: "$105", freshman: "$105" },
  { item: "Shoes: School and Event", accounting: "Due 8/24 · link from Zappos", summer: "$75", fall: "$75", freshman: "$75" },
  { item: "Total due on 8/24 for August tryout", accounting: "", summer: "–", fall: "$442", freshman: "$442", subtotal: true },
  { item: "Camp: TSC", accounting: "Due 5/29 · paid through booster club", summer: "$651", fall: "–", freshman: "–" },
  { item: "Tumbling (paid to Dauntless)", accounting: "$0 registration / $88.27 monthly (incl. fees) by the 15th, through booster club — 9 months (Summer athletes) or 7 months (Fall athletes)", summer: "$795", fall: "$618", freshman: "$618" },
  { item: "Camp: UCA", accounting: "TBD · link from USA/Varsity", summer: "$217", fall: "$217", freshman: "$217" },
  { item: "Warm Up Jacket — new athletes in 26/27 only", accounting: "Due 10/1 · link from Varsity", summer: "$90", fall: "$90", freshman: "$90" },
  { item: "Pom tags", accounting: "Fundraising goal", summer: "$20", fall: "$20", freshman: "$20", fundraising: true },
  { item: "Game Day bow", accounting: "Fundraising goal", summer: "$20", fall: "$20", freshman: "$20", fundraising: true },
  { item: "Breast Cancer / October game apparel: bow, shirt, socks", accounting: "Fundraising goal", summer: "$30", fall: "$30", freshman: "$30", fundraising: true },
  { item: "Christmas party meal / dinner", accounting: "Fundraising goal", summer: "$20", fall: "$20", freshman: "$20", fundraising: true },
  { item: "Gifts / accessories (season socks, Hoco gifts, all-team gifts)", accounting: "Fundraising goal", summer: "$100", fall: "$100", freshman: "$100", fundraising: true },
  { item: "Game Day snacks", accounting: "Fundraising goal", summer: "$20", fall: "$20", freshman: "$20", fundraising: true },
  { item: "Candy: parades / trunk-or-treat / tailgating / gifts / parties", accounting: "Fundraising goal", summer: "$50", fall: "$50", freshman: "$50", fundraising: true },
  { item: "Concession donations — TSC", accounting: "Fundraising goal", summer: "$50", fall: "$50", freshman: "$50", fundraising: true },
  { item: "Coaches gifts — banquet", accounting: "Fundraising goal", summer: "$25", fall: "$25", freshman: "$25", fundraising: true },
  { item: "Banquet (family of 4)", accounting: "Fundraising goal", summer: "$75", fall: "$75", freshman: "$75", fundraising: true },
];

const seniorCostSheetHref = "/downloads/senior-cost-sheet-2026-27.pdf";
const seniorSchedule: { item: string; accounting: string; amount: string; header?: boolean }[] = [
  { item: "Senior Banner", accounting: "Due 8/17 · paid by senior parents thru the booster club account", amount: "$60" },
  { item: "Senior Brunch (athletes & coaches only, 10/24, location TBD, cost estimated)", accounting: "Due 10/24 · athletes & coaches pay for their own food/beverages", amount: "$25" },
  { item: "Senior Night Festivities (all events at the field, details TBD)", accounting: "", amount: "–", header: true },
  { item: "Sashes", accounting: "Due 9/25 · paid by senior parents thru the booster club account", amount: "$20" },
  { item: "Bow", accounting: "Due 9/25 · paid by senior parents thru the booster club account", amount: "$20" },
  { item: "Gifts (e.g. tassel charm / wood bow)", accounting: "Due 9/25 · paid by senior parents thru the booster club account", amount: "$50" },
  { item: "Portraits & photo boards (2 photo frames w/ signed matte & large kinder photo board)", accounting: "Due 9/25 · paid by senior parents thru the booster club account", amount: "$100" },
  { item: "Flowers (bouquet)", accounting: "Due 9/25 · paid by senior parents thru the booster club account", amount: "$20" },
  { item: "End of Season Senior Dinner (athletes & coaches only, location TBD, cost estimated)", accounting: "TBD · athletes & coaches pay for their own food/beverages", amount: "$25" },
  { item: "Banquet Senior Recognition", accounting: "", amount: "–", header: true },
  { item: "Lei's", accounting: "TBD · paid by senior parents thru the booster club account", amount: "$55" },
  { item: "Gifts (e.g. glass cup with bows / senior jars / photos / frames)", accounting: "TBD · paid by senior parents thru the booster club account", amount: "$50" },
];

const otherFees: { item: string; detail: string }[] = [
  { item: "Athletic Fee", detail: "$100.00 — due to the school office prior to the first game" },
  { item: "Homecoming Parade costume", detail: "Average $20–$30 per costume" },
  { item: "Christmas party", detail: "$20.00 gift" },
  { item: "Christmas coaches gifts", detail: "Donated items for gift baskets" },
  { item: "Spirit Week clothing", detail: "Dependent on the individual athlete" },
];
---

<Layout
  title="Parent Info — Millennium Cheer Booster Club"
  description="Season donation schedule, fees, and payment information for Millennium Cheer families."
>
  <section class="border-b border-slate-100 bg-purple-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Parent Info</h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        Everything families need for the 2026–27 season — the full donation
        schedule, other expected fees, and how to make payments. Questions?
        Email
        <a
          href="mailto:MHSSpiritlinebc@gmail.com"
          class="font-medium text-purple-800 hover:text-purple-900"
        >MHSSpiritlinebc@gmail.com</a>.
      </p>
    </div>
  </section>

  {
    highlighted.length > 0 && (
      <section class="mx-auto max-w-5xl px-6 pt-8">
        {highlighted.map((item) => (
          <div class="rounded-lg border border-purple-300 bg-purple-50 p-5">
            <p class="font-semibold text-purple-950">
              📢 {item.data.title}
              {item.data.deadline && (
                <span class="font-normal">
                  {" "}
                  — due{" "}
                  {item.data.deadline.toLocaleDateString("en-US", {
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </span>
              )}
            </p>
            {item.data.link && !item.data.linkPending && (
              <a
                href={item.data.link}
                target="_blank"
                rel="noopener"
                class="mt-3 inline-flex items-center rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
              >
                {item.data.linkLabel ?? "Learn more →"}
              </a>
            )}
          </div>
        ))}
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Donation Schedule</h2>
        <p class="mt-1 text-sm text-slate-500">
          2026–27 full season · as of {asOf}
        </p>
      </div>
      <a
        href={pdfHref}
        class="inline-flex items-center gap-2 rounded-md border border-purple-200 bg-white px-4 py-2 text-sm font-semibold text-purple-800 transition hover:bg-purple-50"
      >
        ⬇ Download PDF
      </a>
    </div>

    <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-600">
            <th class="px-4 py-3 font-semibold">Item / Event</th>
            <th class="px-4 py-3 font-semibold">Due date &amp; accounting</th>
            <th class="px-4 py-3 text-right font-semibold">Summer Start</th>
            <th class="px-4 py-3 text-right font-semibold">Fall Start</th>
            <th class="px-4 py-3 text-right font-semibold">Freshman</th>
          </tr>
        </thead>
        <tbody>
          {schedule.map((row) => (
            <tr class={row.subtotal ? "border-t border-slate-200 bg-slate-50" : "border-t border-slate-100 align-top"}>
              <td class={`px-4 py-3 ${row.subtotal ? "font-semibold text-slate-700" : "font-medium text-slate-800"}`}>{row.item}</td>
              <td class="px-4 py-3 text-slate-600">
                {row.fundraising ? (
                  <span class="inline-flex items-center rounded bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-800">
                    Fundraising goal
                  </span>
                ) : (
                  row.accounting
                )}
              </td>
              <td class="px-4 py-3 text-right tabular-nums text-slate-800">{row.summer}</td>
              <td class="px-4 py-3 text-right tabular-nums text-slate-800">{row.fall}</td>
              <td class="px-4 py-3 text-right tabular-nums text-slate-800">{row.freshman}</td>
            </tr>
          ))}
          <tr class="border-t-2 border-purple-200 bg-purple-50">
            <td class="px-4 py-3 font-bold text-slate-900" colspan="2">Individual Total</td>
            <td class="px-4 py-3 text-right font-bold tabular-nums text-slate-900">$2,605</td>
            <td class="px-4 py-3 text-right font-bold tabular-nums text-slate-900">$2,219</td>
            <td class="px-4 py-3 text-right font-bold tabular-nums text-slate-900">$2,219</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="mt-4 max-w-3xl text-sm text-slate-500">
      Lines marked <span class="font-medium text-purple-800">Fundraising goal</span>
      are targets the booster club works to cover through team fundraising (our
      season team goal is <strong>$18,450</strong>) — so the more we fundraise
      together, the less comes out of pocket. All prices and vendors are subject
      to change.
    </p>
  </section>

  <section class="border-t border-slate-100 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold tracking-tight">Senior Cost Sheet</h2>
          <p class="mt-1 text-sm text-slate-500">
            2026–27 senior-specific costs, on top of the donation schedule above
          </p>
        </div>
        <a
          href={seniorCostSheetHref}
          class="inline-flex items-center gap-2 rounded-md border border-purple-200 bg-white px-4 py-2 text-sm font-semibold text-purple-800 transition hover:bg-purple-50"
        >
          ⬇ Download PDF
        </a>
      </div>

      <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-600">
              <th class="px-4 py-3 font-semibold">Item / Event</th>
              <th class="px-4 py-3 font-semibold">Due date &amp; accounting</th>
              <th class="px-4 py-3 text-right font-semibold">Amount</th>
            </tr>
          </thead>
          <tbody>
            {seniorSchedule.map((row) => (
              row.header ? (
                <tr class="border-t border-slate-200 bg-slate-50">
                  <td class="px-4 py-3 font-semibold text-slate-700" colspan="3">{row.item}</td>
                </tr>
              ) : (
                <tr class="border-t border-slate-100 align-top">
                  <td class="px-4 py-3 font-medium text-slate-800">{row.item}</td>
                  <td class="px-4 py-3 text-slate-600">{row.accounting}</td>
                  <td class="px-4 py-3 text-right tabular-nums text-slate-800">{row.amount}</td>
                </tr>
              )
            ))}
            <tr class="border-t-2 border-purple-200 bg-purple-50">
              <td class="px-4 py-3 font-bold text-slate-900" colspan="2">Total</td>
              <td class="px-4 py-3 text-right font-bold tabular-nums text-slate-900">$425</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mt-4 max-w-3xl text-sm text-slate-500">
        Most senior costs are paid by senior parents directly through the
        booster club account. Questions? Reach the Senior Planning Committee
        below.
      </p>
    </div>
  </section>

  <section class="border-t border-slate-100 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <h2 class="text-2xl font-bold tracking-tight">Other Expected Fees</h2>
      <dl class="mt-6 divide-y divide-slate-100 rounded-lg border border-slate-200">
        {otherFees.map((fee) => (
          <div class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between">
            <dt class="font-medium text-slate-800">{fee.item}</dt>
            <dd class="text-sm text-slate-600 sm:text-right">{fee.detail}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="payments" class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="text-2xl font-bold tracking-tight">Make a Payment</h2>
    <p class="mt-4 max-w-3xl text-slate-600">
      Many items are paid directly through vendor links (see the schedule
      above). Current booster-collected payment links are below — open as
      fundraisers start, and removed once they close.
    </p>

    {paymentLinks.length > 0 && (
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {paymentLinks.map((item) => (
          <article class="flex flex-col rounded-lg border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">{item.data.title}</h3>
            {item.data.note && (
              <p class="mt-1 flex-1 text-sm text-slate-600">{item.data.note}</p>
            )}
            {item.data.link && !item.data.linkPending && (
              <a
                href={item.data.link}
                target="_blank"
                rel="noopener"
                class="mt-3 inline-flex w-fit items-center rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
              >
                Pay / Sign Up →
              </a>
            )}
            {item.data.linkPending && (
              <span
                class="mt-3 inline-flex w-fit cursor-not-allowed items-center rounded-md bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-400 ring-1 ring-inset ring-slate-200"
                aria-disabled="true"
                title="Coming soon"
              >
                Pay / Sign Up — coming soon
              </span>
            )}
          </article>
        ))}
      </div>
    )}

    <p class="mt-8 max-w-3xl text-sm text-slate-500">
      For anything not covered by a specific link above, use our general
      Square checkout:
    </p>
    <div class="mt-3">
      <a
        href="https://square.link/u/ZHknpVj3"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center rounded-md border border-purple-200 bg-white px-5 py-2.5 text-sm font-semibold text-purple-800 transition hover:bg-purple-50"
      >
        Pay / Donate with Square →
      </a>
    </div>
  </section>

  <section class="border-t border-slate-100 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-12">
      <h2 class="text-2xl font-bold tracking-tight">Senior Planning Committee</h2>
      <p class="mt-4 max-w-3xl text-slate-600">
        This committee plans all senior-related events and purchases, working
        directly with the officers on purchases and volunteer needs. Events
        include (but aren't limited to) the Last "First" Game, the Senior Brunch
        (in lieu of the game-night dinner), Senior Night festivities, and the
        end-of-season Banquet.
      </p>

      <div class="mt-6 rounded-lg border border-purple-200 bg-purple-50 p-5">
        <p class="text-sm font-semibold text-purple-900">Want to join?</p>
        <p class="mt-1 text-sm text-slate-700">
          We're looking for members to help plan all senior events and
          purchases. If you're interested, please let
          <strong>Charity</strong> know <strong>in writing</strong> before the
          first meeting. The committee's first meeting will be scheduled right
          after the regular booster meeting on <strong>July 21, 2026</strong>.
        </p>
      </div>

      <div class="mt-6">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-700">
          Committee Members
        </h3>
        <dl class="mt-3 grid gap-x-8 gap-y-1 text-sm text-slate-700 sm:grid-cols-2">
          <div class="flex gap-2">
            <dt class="font-medium text-slate-900">Chair:</dt>
            <dd>Nikki Manche</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-slate-900">Members:</dt>
            <dd>Shauna McCloskey, Jane Schwalm, Rhea Isla, Kahala Gaddis, Charity Farling</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Layout>
