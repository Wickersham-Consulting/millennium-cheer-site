---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const minutes = (
  await getCollection("minutes", ({ data }) => data.published)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const byYear: Record<string, typeof minutes> = {};
for (const m of minutes) {
  const year = String(m.data.date.getUTCFullYear());
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(m);
}
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<Layout
  title="Meeting Minutes — Millennium Cheer Booster Club"
  description="Booster club meeting minutes for the Millennium Cheer program."
>
  <section class="border-b border-slate-100 bg-purple-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Meeting Minutes
      </h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        Notes from our monthly booster club meetings. Open a meeting below
        to download the PDF. Missing or incorrect? Email
        <a
          href="mailto:mhsspiritlinebc@gmail.com"
          class="font-medium text-purple-800 hover:text-purple-900"
        >mhsspiritlinebc@gmail.com</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-12">
    {
      minutes.length === 0 ? (
        <p class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-500">
          No minutes posted yet — check back soon.
        </p>
      ) : (
        <div class="space-y-10">
          {years.map((year) => (
            <div>
              <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">
                {year}
              </h2>
              <ul class="mt-3 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
                {byYear[year].map((m) => (
                  <li>
                    <a
                      href={m.data.pdf}
                      target="_blank"
                      rel="noopener"
                      class="flex items-center justify-between gap-4 px-5 py-4 transition hover:bg-purple-50"
                    >
                      <div>
                        <p class="font-semibold text-slate-800">
                          {m.data.title}
                        </p>
                        <p class="text-xs text-slate-500">
                          {m.data.date.toLocaleDateString("en-US", {
                            weekday: "long",
                            month: "long",
                            day: "numeric",
                            year: "numeric",
                            timeZone: "UTC",
                          })}
                        </p>
                        {m.data.summary && (
                          <p class="mt-1 text-sm text-slate-600">{m.data.summary}</p>
                        )}
                      </div>
                      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-purple-300 bg-white px-3 py-1.5 text-xs font-semibold text-purple-800">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-3.5 w-3.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"
                          />
                        </svg>
                        PDF
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </section>
</Layout>
