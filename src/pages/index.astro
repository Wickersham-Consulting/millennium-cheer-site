---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import RichText from "../components/RichText.astro";
import stateChampions from "../assets/photos/state-champions.jpg";

const achievements = (await getCollection("achievements", ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const announcements = (await getCollection("announcements", ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const highlighted = announcements.filter((a) => a.data.highlight);

const gallery = (await getCollection("gallery", ({ data }) => data.published))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const competitions = (await getCollection("competitions", ({ data }) => data.published))
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<Layout>
  {
    highlighted.map((item) => (
      <div class="bg-purple-700 text-white">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-3 text-sm">
          <p class="font-semibold">
            📢 {item.data.title}
            {item.data.deadline && (
              <span class="font-normal">
                {" "}
                — due{" "}
                {item.data.deadline.toLocaleDateString("en-US", {
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                })}
              </span>
            )}
          </p>
          {item.data.link && !item.data.linkPending && (
            <a
              href={item.data.link}
              target="_blank"
              rel="noopener"
              class="shrink-0 rounded-md bg-white px-3 py-1.5 font-semibold text-purple-900 transition hover:bg-purple-50"
            >
              {item.data.linkLabel ?? "Learn more →"}
            </a>
          )}
        </div>
      </div>
    ))
  }
  <section class="relative overflow-hidden bg-purple-950 text-white">
    <div class="absolute inset-0 opacity-30">
      <Image
        src={stateChampions}
        alt=""
        loading="eager"
        class="absolute inset-0 h-full w-full object-cover"
        widths={[800, 1200, 1800]}
        sizes="100vw"
      />
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 h-full w-full object-cover"
      >
        <source src="/videos/cheer-clip.mp4" type="video/mp4" />
      </video>
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-purple-950 via-purple-950/85 to-purple-950/40"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 py-24 sm:py-32">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-purple-300">
        Go Tigers
      </p>
      <h1
        class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl"
      >
        Cheering on our team — <span class="text-purple-300">together</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-purple-100">
        The Millennium Cheer Booster Club supports the Millennium Tigers
        cheerleaders through fundraising, community events, and direct
        sponsorship. Every dollar helps cover competition fees, uniforms,
        travel, and the experiences that make cheer unforgettable.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#support"
          class="inline-flex items-center rounded-md bg-white px-5 py-2.5 text-sm font-semibold text-purple-900 shadow-sm transition hover:bg-purple-50"
        >
          Support the Club
        </a>
        <a
          href="/events"
          class="inline-flex items-center rounded-md border border-purple-300/60 bg-purple-900/30 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-purple-900/60"
        >
          Upcoming Events
        </a>
      </div>
    </div>
  </section>

  {
    achievements.length > 0 && (
      <section class="border-b border-slate-100 bg-white">
        <div class="mx-auto max-w-5xl px-6 py-16">
          <div class="flex items-baseline justify-between">
            <h2 class="text-2xl font-bold tracking-tight">Recent Achievements</h2>
            <span class="text-sm text-slate-500">{achievements[0].data.season}</span>
          </div>
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {achievements.map((item) => (
              <article class="overflow-hidden rounded-lg border border-slate-200 bg-white">
                <Image
                  src={item.data.photo}
                  alt={item.data.photoAlt}
                  widths={[400, 800]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="h-56 w-full object-cover"
                />
                <div class="p-5">
                  <p class="text-xs font-semibold uppercase tracking-wider text-purple-700">
                    {item.data.season}
                  </p>
                  <h3 class="mt-1 text-lg font-semibold">{item.data.title}</h3>
                  {item.data.summary && (
                    <p class="mt-2 text-sm text-slate-600"><RichText text={item.data.summary} /></p>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    competitions.length > 0 && (
      <section class="border-b border-purple-900 bg-purple-950 text-white">
        <div class="mx-auto max-w-5xl px-6 py-16">
          <h2 class="text-2xl font-bold tracking-tight">Competition Schedule</h2>
          <p class="mt-2 text-purple-200">
            Come cheer on the Tigers! Our 2026–27 competition season:
          </p>
          <ul class="mt-8 divide-y divide-purple-800/60 border-y border-purple-800/60">
            {competitions.map((c) => (
              <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:gap-4">
                <span class="shrink-0 font-semibold text-purple-300 sm:w-36">
                  {c.data.dateLabel}
                </span>
                <div class="flex-1">
                  <p class="font-semibold">{c.data.title}</p>
                  <p class="text-sm text-purple-200">
                    {[c.data.teams, c.data.location].filter(Boolean).join(" · ")}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight">About the Club</h2>
    <p class="mt-4 max-w-3xl text-slate-600">
      We're a parent-run, all-volunteer 501(c)(3) supporting Millennium High
      School's cheer program. We organize fundraisers throughout the year —
      car washes, concessions, merchandise, and direct donation drives — and
      every dollar raised goes back to our athletes.
    </p>
  </section>

  {
    announcements.length > 0 && (
      <section class="border-y border-slate-100 bg-purple-50">
        <div class="mx-auto max-w-5xl px-6 py-16">
          <h2 class="text-2xl font-bold tracking-tight">Announcements</h2>
          <div class="mt-6 space-y-4">
            {announcements.map((item) => (
              <article class="rounded-lg border border-purple-200 bg-white p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-lg font-semibold">{item.data.title}</h3>
                  {item.data.deadline && (
                    <span class="text-xs font-medium text-purple-800">
                      Deadline: {item.data.deadline.toLocaleDateString("en-US", {
                        month: "long",
                        day: "numeric",
                        year: "numeric",
                        timeZone: "UTC",
                      })}
                    </span>
                  )}
                </div>
                <p class="mt-2 text-sm whitespace-pre-line text-slate-600"><RichText text={item.data.summary} /></p>
                <div class="mt-4 flex flex-wrap items-center gap-3">
                  {item.data.link && !item.data.linkPending && (
                    <a
                      href={item.data.link}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
                    >
                      {item.data.linkLabel ?? "Learn more →"}
                    </a>
                  )}
                  {item.data.linkPending && (
                    <span
                      class="inline-flex cursor-not-allowed items-center rounded-md bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-400 ring-1 ring-inset ring-slate-200"
                      aria-disabled="true"
                      title="Payment link coming soon"
                    >
                      {item.data.linkLabel ?? "Payment"} — coming soon
                    </span>
                  )}
                  {item.data.zoomLink && (
                    <a
                      href={item.data.zoomLink}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
                    >
                      Join via Zoom →
                    </a>
                  )}
                  {item.data.contactEmail && (
                    <a
                      href={`mailto:${item.data.contactEmail}`}
                      class="text-sm font-medium text-purple-800 hover:text-purple-900"
                    >
                      {item.data.contactEmail}
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    gallery.length > 0 && (
      <section class="border-y border-slate-100 bg-white">
        <div class="mx-auto max-w-5xl px-6 py-16">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="text-2xl font-bold tracking-tight">On the Sidelines</h2>
              <p class="mt-2 text-slate-600">
                Moments from competitions, games, and team events.
              </p>
            </div>
            <a
              href="https://www.instagram.com/millennium_cheer/"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
            >
              Follow @millennium_cheer →
            </a>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {gallery.map((item) => (
              <figure class="overflow-hidden rounded-lg border border-slate-200 bg-white">
                <Image
                  src={item.data.image}
                  alt={item.data.alt}
                  widths={[300, 600]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
                  class="aspect-square w-full object-cover"
                />
                {item.data.caption && (
                  <figcaption class="px-3 py-2 text-xs text-slate-600">
                    {item.data.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="support" class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight">Ways to Support</h2>
    <p class="mt-4 max-w-3xl text-slate-600">
      Donate directly, sponsor a competition, or grab club merchandise.
      Every contribution is tax-deductible — we'll provide receipts on
      request.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="flex flex-col rounded-lg border border-slate-200 p-6">
        <h3 class="font-semibold">Donate</h3>
        <p class="mt-2 flex-1 text-sm text-slate-600">
          One-time or recurring donations through our secure Square link.
        </p>
        <a
          href="https://square.link/u/ZHknpVj3"
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center self-start rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
        >
          Donate with Square →
        </a>
      </div>
      <div class="flex flex-col rounded-lg border border-slate-200 p-6">
        <h3 class="font-semibold">Sponsor</h3>
        <p class="mt-2 flex-1 text-sm text-slate-600">
          Local business? Reach our community while supporting the team.
        </p>
        <a
          href="/sponsorship"
          class="mt-4 inline-flex items-center self-start rounded-md border border-purple-700 px-4 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-50"
        >
          See Sponsorship Tiers →
        </a>
      </div>
      <div class="flex flex-col rounded-lg border border-slate-200 p-6">
        <h3 class="font-semibold">Merchandise</h3>
        <p class="mt-2 flex-1 text-sm text-slate-600">
          Show your support with club gear — everyday spirit wear, plus a
          fundraiser store where a portion of every order comes back to the team.
        </p>
        <a
          href="/shop"
          class="mt-4 inline-flex items-center self-start rounded-md border border-purple-700 px-4 py-2 text-sm font-semibold text-purple-700 transition hover:bg-purple-50"
        >
          Shop Spirit Wear →
        </a>
      </div>
    </div>
  </section>
</Layout>
