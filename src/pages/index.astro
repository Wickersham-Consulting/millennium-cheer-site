---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="border-b border-slate-100 bg-gradient-to-b from-rose-50 to-white">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
      <p class="mb-3 text-sm font-medium uppercase tracking-wider text-rose-700">
        Welcome
      </p>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        Cheering on our team — <span class="text-rose-700">together</span>.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-600">
        The Millennium Cheer Booster Club supports our cheerleaders through
        fundraising, community events, and direct sponsorship. Every dollar
        helps cover competition fees, uniforms, travel, and the experiences
        that make cheer unforgettable.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#support"
          class="inline-flex items-center rounded-md bg-rose-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-800"
        >
          Support the Club
        </a>
        <a
          href="#fundraisers"
          class="inline-flex items-center rounded-md border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          See Current Fundraisers
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight">About the Club</h2>
    <p class="mt-4 max-w-3xl text-slate-600">
      We're a parent-run, all-volunteer 501(c)(3) supporting Millennium's
      cheer program. We organize fundraisers throughout the year — car
      washes, concessions, merchandise, and direct donation drives — and
      every dollar raised goes back to our athletes.
    </p>
  </section>

  <section
    id="fundraisers"
    class="border-y border-slate-100 bg-slate-50"
  >
    <div class="mx-auto max-w-5xl px-6 py-16">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-bold tracking-tight">Current Fundraisers</h2>
        <span class="text-sm text-slate-500">Updated regularly</span>
      </div>
      <p class="mt-4 max-w-3xl text-slate-600">
        Active fundraising events will be listed here. Check back soon for
        upcoming car washes, merchandise drops, and donation drives.
      </p>
      <div class="mt-8 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
        No active fundraisers right now — content coming soon.
      </div>
    </div>
  </section>

  <section id="support" class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="text-2xl font-bold tracking-tight">Ways to Support</h2>
    <p class="mt-4 max-w-3xl text-slate-600">
      Donate directly, sponsor a competition, or grab club merchandise.
      Every contribution is tax-deductible — we'll provide receipts on
      request.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-slate-200 p-6">
        <h3 class="font-semibold">Donate</h3>
        <p class="mt-2 text-sm text-slate-600">
          One-time or recurring donations through our secure Square link.
        </p>
        <p class="mt-4 text-xs text-slate-400">Coming soon</p>
      </div>
      <div class="rounded-lg border border-slate-200 p-6">
        <h3 class="font-semibold">Sponsor</h3>
        <p class="mt-2 text-sm text-slate-600">
          Local business? Reach our community while supporting the team.
        </p>
        <p class="mt-4 text-xs text-slate-400">Coming soon</p>
      </div>
      <div class="rounded-lg border border-slate-200 p-6">
        <h3 class="font-semibold">Merchandise</h3>
        <p class="mt-2 text-sm text-slate-600">
          Show your support with club gear — shirts, decals, and more.
        </p>
        <p class="mt-4 text-xs text-slate-400">Coming soon</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <div class="rounded-lg border border-slate-200 bg-slate-50 p-6 text-sm text-slate-500">
      <strong class="text-slate-700">Site under construction.</strong>
      The booster club site is being built out — calendar, meeting minutes,
      and an active fundraisers list will be available shortly.
    </div>
  </section>
</Layout>
