---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("thanks");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"thanks">;
}

const { entry } = Astro.props;
const { title, headline, summary, nextSteps, showLogoUploadCTA, primaryCTA } =
  entry.data;
---

<Layout title={title}>
  <section class="bg-gradient-to-b from-purple-50 to-white">
    <div class="mx-auto max-w-3xl px-6 py-20 sm:py-28">
      <p class="text-sm font-semibold uppercase tracking-wider text-purple-700">
        Thank you
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        {headline}
      </h1>
      {summary && <p class="mt-6 text-lg text-slate-700">{summary}</p>}

      {
        nextSteps && nextSteps.length > 0 && (
          <div class="mt-10 rounded-lg border border-purple-200 bg-white p-6">
            <h2 class="text-lg font-semibold">What's next</h2>
            <ul class="mt-4 space-y-3 text-sm text-slate-700">
              {nextSteps.map((step) => (
                <li class="flex gap-3">
                  <span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-purple-700" />
                  <span>{step}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        showLogoUploadCTA && (
          <div class="mt-6 rounded-lg border border-purple-300 bg-purple-50 p-5 text-sm text-slate-700">
            <strong class="text-slate-900">Don't forget:</strong> email your
            high-resolution logo to{" "}
            <a
              href="mailto:mhsspiritlinebc@gmail.com"
              class="font-medium text-purple-800 hover:text-purple-900"
            >
              mhsspiritlinebc@gmail.com
            </a>{" "}
            so we can include it on banners and social media shoutouts.
          </div>
        )
      }

      <div class="mt-12 flex flex-wrap gap-3">
        {
          primaryCTA && (
            <a
              href={primaryCTA.href}
              class="inline-flex items-center rounded-md bg-purple-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-purple-800"
            >
              {primaryCTA.label} →
            </a>
          )
        }
        <a
          href="/"
          class="inline-flex items-center rounded-md border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          Back to home
        </a>
      </div>

      <p class="mt-12 text-2xl font-black uppercase italic tracking-wide text-purple-800">
        Fear the Roar
      </p>
    </div>
  </section>
</Layout>
