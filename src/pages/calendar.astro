---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const events = (await getCollection("events", ({ data }) => data.published))
  .sort((a, b) => a.data.sortDate.getTime() - b.data.sortDate.getTime());

// Group events by year-month for monthly blocks.
const byMonthKey: Record<string, typeof events> = {};
for (const event of events) {
  const date = event.data.sortDate;
  const key = `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}`;
  if (!byMonthKey[key]) byMonthKey[key] = [];
  byMonthKey[key].push(event);
}

// Show this month and the next 11. Fill in empty months so the calendar
// looks like a real year-at-a-glance even before all events are loaded.
const now = new Date();
const startMonth = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));
const months: { key: string; label: string; entries: typeof events }[] = [];
for (let i = 0; i < 12; i++) {
  const d = new Date(Date.UTC(startMonth.getUTCFullYear(), startMonth.getUTCMonth() + i, 1));
  const key = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, "0")}`;
  const label = d.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
  months.push({ key, label, entries: byMonthKey[key] ?? [] });
}

function dayOfMonth(d: Date) {
  return String(d.getUTCDate()).padStart(2, "0");
}
---

<Layout
  title="Calendar — Millennium Cheer Booster Club"
  description="Schedule of upcoming events, fundraisers, and team activities for the Millennium Cheer Booster Club."
>
  <section class="border-b border-slate-100 bg-purple-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Year at a Glance
      </h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        Upcoming events, fundraisers, and team milestones. Times subject
        to change — check back regularly. Need to add or correct an
        event? Email
        <a
          href="mailto:mhsspiritlinebc@gmail.com"
          class="font-medium text-purple-800 hover:text-purple-900"
        >mhsspiritlinebc@gmail.com</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        months.map((month) => (
          <article class="rounded-lg border border-slate-200 bg-white">
            <header class="border-b border-slate-200 bg-slate-50 px-5 py-3">
              <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700">
                {month.label}
              </h2>
            </header>
            <div class="px-5 py-4">
              {month.entries.length === 0 ? (
                <p class="text-sm italic text-slate-400">Nothing posted yet.</p>
              ) : (
                <ul class="space-y-3 text-sm">
                  {month.entries.map((event) => (
                    <li class="flex gap-3">
                      <span class="shrink-0 rounded bg-purple-100 px-2 py-0.5 font-mono text-xs font-semibold text-purple-800">
                        {dayOfMonth(event.data.sortDate)}
                      </span>
                      <div class="flex-1">
                        <p class="font-semibold text-slate-800">
                          {event.data.title}
                        </p>
                        <p class="text-xs text-slate-500">{event.data.when}</p>
                        {event.data.location && (
                          <p class="text-xs text-slate-500">{event.data.location}</p>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-slate-500">
      Looking for sign-ups and payment links?
      <a
        href="/events"
        class="font-medium text-purple-800 hover:text-purple-900"
      >See the events page →</a>
    </p>
  </section>
</Layout>
