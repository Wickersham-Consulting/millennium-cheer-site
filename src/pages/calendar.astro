---
import Layout from "../layouts/Layout.astro";
import { loadCalendar, type CalEvent } from "../lib/sportsyou";
import snapshotIcs from "../data/sportsyou.ics?raw";

const events = await loadCalendar(snapshotIcs);

// All dates are displayed in Arizona time (no DST → fixed UTC-7).
const TZ = "America/Phoenix";
const fmtMonth = new Intl.DateTimeFormat("en-US", { timeZone: TZ, month: "long", year: "numeric" });
const fmtTime = new Intl.DateTimeFormat("en-US", { timeZone: TZ, hour: "numeric", minute: "2-digit" });
const fmtDayParts = new Intl.DateTimeFormat("en-CA", { timeZone: TZ, year: "numeric", month: "2-digit", day: "2-digit" });

// Calendar day for an event. All-day events were stored at UTC midnight, so read
// their date straight off (converting to AZ would shift them back a day); timed
// events are converted into Arizona time.
function dayParts(e: CalEvent): { y: number; m: number; d: number } {
  if (e.allDay) {
    return { y: e.start.getUTCFullYear(), m: e.start.getUTCMonth() + 1, d: e.start.getUTCDate() };
  }
  const [y, m, d] = fmtDayParts.format(e.start).split("-").map(Number);
  return { y, m, d };
}

const monthKey = (y: number, m: number) => `${y}-${String(m).padStart(2, "0")}`;

// Bucket events by Arizona month.
const byMonth: Record<string, CalEvent[]> = {};
for (const e of events) {
  const { y, m } = dayParts(e);
  (byMonth[monthKey(y, m)] ??= []).push(e);
}

// Window: the current Arizona month plus the next 11.
const nowParts = fmtDayParts.format(new Date()).split("-").map(Number);
const months: { key: string; label: string; entries: CalEvent[] }[] = [];
for (let i = 0; i < 12; i++) {
  const d = new Date(Date.UTC(nowParts[0], nowParts[1] - 1 + i, 1, 12));
  const key = monthKey(d.getUTCFullYear(), d.getUTCMonth() + 1);
  const entries = (byMonth[key] ?? []).sort(
    (a, b) => a.start.getTime() - b.start.getTime(),
  );
  months.push({ key, label: fmtMonth.format(d), entries });
}

const hasAnything = months.some((m) => m.entries.length > 0);
---

<Layout
  title="Calendar — Millennium Cheer Booster Club"
  description="Schedule of upcoming events, fundraisers, and team activities for the Millennium Cheer Booster Club."
>
  <section class="border-b border-slate-100 bg-purple-50">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Year at a Glance
      </h1>
      <p class="mt-4 max-w-2xl text-slate-600">
        Upcoming games, fundraisers, and team milestones, synced from the
        coaches' official SportsYou calendar. Routine practices and weightroom
        sessions are shown in gray. Times are Arizona time and subject to
        change — check SportsYou for the latest.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-12">
    {!hasAnything && (
      <p class="text-center text-slate-500">The calendar is being updated — check back soon.</p>
    )}
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        months.map((month) => (
          <article class="rounded-lg border border-slate-200 bg-white">
            <header class="border-b border-slate-200 bg-slate-50 px-5 py-3">
              <h2 class="text-sm font-bold uppercase tracking-wider text-slate-700">
                {month.label}
              </h2>
            </header>
            <div class="px-5 py-4">
              {month.entries.length === 0 ? (
                <p class="text-sm italic text-slate-400">Nothing posted yet.</p>
              ) : (
                <ul class="space-y-3 text-sm">
                  {month.entries.map((event) => (
                    <li class="flex gap-3">
                      <span
                        class:list={[
                          "shrink-0 rounded px-2 py-0.5 font-mono text-xs font-semibold",
                          event.routine
                            ? "bg-slate-100 text-slate-400"
                            : "bg-purple-100 text-purple-800",
                        ]}
                      >
                        {String(dayParts(event).d).padStart(2, "0")}
                      </span>
                      <div class="flex-1">
                        <p
                          class:list={[
                            event.routine
                              ? "text-slate-400"
                              : "font-semibold text-slate-800",
                          ]}
                        >
                          {event.title}
                        </p>
                        {!event.allDay && (
                          <p class="text-xs text-slate-500">{fmtTime.format(event.start)}</p>
                        )}
                        {event.location && (
                          <p class="text-xs text-slate-500">{event.location}</p>
                        )}
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-slate-500">
      Looking for sign-ups and payment links?
      <a
        href="/events"
        class="font-medium text-purple-800 hover:text-purple-900"
      >See the events page →</a>
    </p>
  </section>
</Layout>
