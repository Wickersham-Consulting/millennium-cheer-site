---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Shop — Millennium Cheer Booster Club"
  description="Shop Millennium Tigers Cheer spirit wear — two ways to order, one that fundraises for the team."
>
  <section class="border-b border-slate-100 bg-purple-950 text-white">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <p class="text-sm font-semibold uppercase tracking-wider text-purple-300">
        Tigers Spirit Wear
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Shop</h1>
      <p class="mt-4 max-w-2xl text-purple-100">
        Two ways to rep the Tigers — pick whichever fits what you're after.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <div class="grid gap-6 sm:grid-cols-2">
      <article class="flex flex-col rounded-lg border border-slate-200 bg-white p-6">
        <span class="inline-flex w-fit items-center rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
          Everyday spirit wear
        </span>
        <h2 class="mt-3 text-xl font-semibold text-slate-900">Spirit Wear Store</h2>
        <p class="mt-2 flex-1 text-sm text-slate-600">
          Browse tees, tanks, and sweatshirts anytime through our store
          partner (Deco Apparel) — they handle sizing, payment, printing, and
          shipping directly.
        </p>
        <a
          href="/shop/spirit-wear"
          class="mt-5 inline-flex items-center justify-center rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
        >
          Browse the store →
        </a>
      </article>

      <article class="flex flex-col rounded-lg border border-purple-200 bg-purple-50 p-6">
        <span class="inline-flex w-fit items-center rounded bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-800">
          Team fundraiser
        </span>
        <h2 class="mt-3 text-xl font-semibold text-slate-900">Shirts by Sammie</h2>
        <p class="mt-2 flex-1 text-sm text-slate-600">
          A fundraiser order form with a wider range of designs and products —
          <strong>a portion of every order comes back to the booster club.</strong>
        </p>
        <a
          href="/shop/fundraiser"
          class="mt-5 inline-flex items-center justify-center rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-800"
        >
          Order &amp; support the team →
        </a>
      </article>
    </div>
  </section>
</Layout>
