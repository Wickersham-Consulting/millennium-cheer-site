---
import Layout from "../../layouts/Layout.astro";

// Shirts by Sam — a seasonal fundraiser order form (not a live storefront).
// A portion of every order comes back to the booster club. The form itself
// handles product selection/pricing; payment happens after submission per
// the form's own instructions. Embed height matches the six design sections
// + size/color pickers Sam's form includes.
const formEmbedSrc =
  "https://docs.google.com/forms/d/e/1FAIpQLSf69NkckHUFpJ5_cvs2zPwHOfkxwZ2OWhxqIw_kmJwbr2-jYg/viewform?embedded=true";
const formLink = "https://forms.gle/p2LLvkUrj5e4SGsR6";
---

<Layout
  title="Shirts by Sam Fundraiser — Millennium Cheer Booster Club"
  description="Order 26-27 spirit wear from Shirts by Sam — a portion of every order supports the Millennium Cheer Booster Club."
>
  <section class="border-b border-slate-100 bg-purple-950 text-white">
    <div class="mx-auto max-w-3xl px-6 py-14">
      <p class="text-sm font-semibold uppercase tracking-wider text-purple-300">
        Team Fundraiser
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Shirts by Sam</h1>
      <p class="mt-4 text-purple-100">
        A fundraiser order form with tees, sweatshirts, hats, bags, and more —
        <strong>a portion of every order comes back to the booster club.</strong>
        Fill out the form below to order. Questions? Email
        <a
          href="mailto:shirtsbysammie@gmail.com"
          class="font-medium text-white underline hover:text-purple-200"
        >shirtsbysammie@gmail.com</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-8">
    <div class="rounded-lg border border-purple-200 bg-purple-50 p-5 text-sm text-slate-700">
      <p>
        <strong>Payment:</strong> Payment options are shown at the end of the
        form and must be completed after you submit your order — orders
        aren't processed until payment is received.
      </p>
    </div>

    <div class="mt-6 overflow-hidden rounded-lg border border-slate-200">
      <iframe
        src={formEmbedSrc}
        width="100%"
        height="20472"
        style="border: 0; display: block;"
        title="Shirts by Sam order form"
      >Loading…</iframe>
    </div>

    <p class="mt-4 text-center text-sm text-slate-500">
      Form not loading?
      <a
        href={formLink}
        target="_blank"
        rel="noopener"
        class="font-medium text-purple-800 hover:text-purple-900"
      >Open it directly →</a>
    </p>
  </section>
</Layout>
