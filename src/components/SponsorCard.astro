---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  sponsor: CollectionEntry<"sponsors">;
}

const { sponsor } = Astro.props;
const { name, logo, url } = sponsor.data;
---

{
  url ? (
    <a href={url} target="_blank" rel="noopener" aria-label={name}>
      <div class="flex h-32 w-full items-center justify-center rounded-lg border border-slate-200 bg-white p-6 transition hover:border-purple-300 hover:shadow-sm">
        {logo ? (
          <Image src={logo} alt={name} widths={[200, 400]} sizes="(min-width: 640px) 30vw, 45vw" class="max-h-20 w-auto object-contain" />
        ) : (
          <span class="text-center text-sm font-semibold text-slate-700">{name}</span>
        )}
      </div>
    </a>
  ) : (
    <div class="flex h-32 w-full items-center justify-center rounded-lg border border-slate-200 bg-white p-6">
      {logo ? (
        <Image src={logo} alt={name} widths={[200, 400]} sizes="(min-width: 640px) 30vw, 45vw" class="max-h-20 w-auto object-contain" />
      ) : (
        <span class="text-center text-sm font-semibold text-slate-700">{name}</span>
      )}
    </div>
  )
}
