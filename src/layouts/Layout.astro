---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoBadge from "../assets/logo-badge.png";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Millennium Cheer Booster Club",
  description = "Supporting the Millennium Tigers cheerleaders through fundraising, sponsorship, and community.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-full bg-white text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div
        class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
      >
        <a href="/" class="flex items-center gap-3 group">
          <Image
            src={logoBadge}
            alt="Millennium Cheer Booster Club logo"
            width={44}
            height={44}
            class="h-11 w-11 shrink-0"
          />
          <div class="leading-tight">
            <span
              class="block text-base font-black uppercase tracking-tight text-purple-800 group-hover:text-purple-900 sm:text-lg"
              >Millennium Cheer</span
            >
            <span class="hidden text-xs text-slate-500 sm:block">Booster Club</span>
          </div>
        </a>
        <nav class="hidden gap-6 text-sm text-slate-600 sm:flex">
          <a href="/" class="hover:text-purple-800">Home</a>
          <a href="/events" class="hover:text-purple-800">Events</a>
          <a href="#support" class="hover:text-purple-800">Support Us</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-slate-200 bg-slate-50">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:justify-between"
      >
        <p>&copy; {new Date().getFullYear()} Millennium Cheer Booster Club</p>
        <p>
          A 501(c)(3) nonprofit · <a
            href="mailto:MHSSpiritlinebc@gmail.com"
            class="text-slate-600 hover:text-purple-800"
            >MHSSpiritlinebc@gmail.com</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
