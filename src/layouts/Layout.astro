---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Millennium Cheer Booster Club",
  description = "Supporting our cheerleaders through fundraisers, sponsorships, and community.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-full bg-white text-slate-900 antialiased">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
        <a href="/" class="font-semibold tracking-tight">
          Millennium Cheer Booster Club
        </a>
        <nav class="hidden gap-6 text-sm text-slate-600 sm:flex">
          <a href="/" class="hover:text-slate-900">Home</a>
          <a href="#fundraisers" class="hover:text-slate-900">Fundraisers</a>
          <a href="#support" class="hover:text-slate-900">Support Us</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-slate-200">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-2 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:justify-between"
      >
        <p>&copy; {new Date().getFullYear()} Millennium Cheer Booster Club</p>
        <p>A 501(c)(3) nonprofit</p>
      </div>
    </footer>
  </body>
</html>
