---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoBadge from "../assets/logo-badge.png";

interface Props {
  title?: string;
  description?: string;
  // Set on draft/preview pages so search engines don't index them.
  noindex?: boolean;
}

const {
  title = "Millennium Cheer Booster Club",
  description = "Supporting the Millennium Tigers cheerleaders through fundraising, sponsorship, and community.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-full bg-white text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div
        class="mx-auto flex max-w-5xl flex-col items-start gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <a href="/" class="flex items-center gap-3 group">
          <Image
            src={logoBadge}
            alt="Millennium Cheer Booster Club logo"
            width={44}
            height={44}
            class="h-11 w-11 shrink-0"
          />
          <div class="leading-tight">
            <span
              class="block text-base font-black uppercase tracking-tight text-purple-800 group-hover:text-purple-900 sm:text-lg"
              >Millennium Cheer</span
            >
            <span class="hidden text-xs text-slate-500 sm:block">Booster Club</span>
          </div>
        </a>
        <nav class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-slate-600">
          <a href="/" class="hover:text-purple-800">Home</a>
          <a href="/events" class="hover:text-purple-800">Events</a>
          <a href="/calendar" class="hover:text-purple-800">Calendar</a>
          <a href="/minutes" class="hover:text-purple-800">Minutes</a>
          <a href="/parent-info" class="hover:text-purple-800">Parents</a>
          <a href="/shop" class="hover:text-purple-800">Shop</a>
          <a href="/sponsorship" class="hover:text-purple-800">Sponsor</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-slate-200 bg-slate-50">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>&copy; {new Date().getFullYear()} Millennium Cheer Booster Club</p>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <a
            href="https://www.instagram.com/millennium_cheer/"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-slate-600 hover:text-purple-800"
            aria-label="Instagram @millennium_cheer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.336 3.608 1.311.974.974 1.249 2.241 1.311 3.608.058 1.266.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.062 1.366-.336 2.633-1.311 3.608-.974.974-2.241 1.249-3.608 1.311-1.266.058-1.645.07-4.85.07-3.204 0-3.584-.012-4.849-.07-1.366-.062-2.633-.336-3.608-1.311-.974-.974-1.249-2.241-1.311-3.608C2.175 15.747 2.163 15.367 2.163 12s.012-3.584.07-4.849c.062-1.366.336-2.633 1.311-3.608.974-.974 2.242-1.249 3.608-1.311C8.416 2.175 8.796 2.163 12 2.163zm0 1.838c-3.141 0-3.512.012-4.752.069-1.045.048-1.628.218-2.012.371-.508.197-.872.432-1.254.814-.382.382-.617.746-.814 1.254-.153.384-.323.967-.371 2.012-.057 1.24-.069 1.611-.069 4.752s.012 3.512.069 4.752c.048 1.045.218 1.628.371 2.012.197.508.432.872.814 1.254.382.382.746.617 1.254.814.384.153.967.323 2.012.371 1.24.057 1.611.069 4.752.069s3.512-.012 4.752-.069c1.045-.048 1.628-.218 2.012-.371.508-.197.872-.432 1.254-.814.382-.382.617-.746.814-1.254.153-.384.323-.967.371-2.012.057-1.24.069-1.611.069-4.752s-.012-3.512-.069-4.752c-.048-1.045-.218-1.628-.371-2.012-.197-.508-.432-.872-.814-1.254-.382-.382-.746-.617-1.254-.814-.384-.153-.967-.323-2.012-.371-1.24-.057-1.611-.069-4.752-.069zm0 3.135a4.864 4.864 0 1 1 0 9.728 4.864 4.864 0 0 1 0-9.728zm0 8.025a3.162 3.162 0 1 0 0-6.324 3.162 3.162 0 0 0 0 6.324zm6.182-8.227a1.137 1.137 0 1 1-2.274 0 1.137 1.137 0 0 1 2.274 0z"></path>
            </svg>
            @millennium_cheer
          </a>
          <span class="hidden text-slate-300 sm:inline">·</span>
          <a
            href="mailto:MHSSpiritlinebc@gmail.com"
            class="text-slate-600 hover:text-purple-800"
            >MHSSpiritlinebc@gmail.com</a
          >
          <span class="hidden text-slate-300 sm:inline">·</span>
          <span>501(c)(3)</span>
        </div>
      </div>
    </footer>
  </body>
</html>
